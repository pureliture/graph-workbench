{
  "name": "@pureliture/graph-workbench",
  "version": "0.1.0",
  "description": "Reusable TypeScript 3D graph workbench",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "npm run build && npm test",
    "check:browser": "npm run check && npm --prefix sites/browser-fixture run lint && npm run site:build && node --test sites/browser-fixture/tests/rendered-html.test.mjs && npm run test:browser",
    "check:issue-1": "npm run check:browser",
    "demo": "vite --host 127.0.0.1",
    "site:build": "npm --prefix sites/browser-fixture run build",
    "test": "vitest run",
    "test:browser": "npm --prefix sites/browser-fixture run test:browser"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "3d",
    "3d-force-graph",
    "graph",
    "three",
    "typescript"
  ],
  "dependencies": {
    "3d-force-graph": "1.80.0",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
